# ─────────────────────────────────────────────────────────────────────────────
# TRADElogs — environment reference
#
# This file documents every variable the app reads (see packages/config/src/index.ts).
# Copy to `.env` for local dev, or use it as the checklist when configuring the
# Railway services. Values here are PLACEHOLDERS — never commit real secrets.
#
# Each variable is tagged with the service(s) that need it:
#   [API]    the Express API service
#   [WORKER] the background jobs service (weekly AI review)
#   [WEB]    the Next.js app (uses NEXT_PUBLIC_* — see the bottom block)
# Many are optional; a feature simply stays off when its keys are absent.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core runtime ──────────────────────────────────────────────────────────────
NODE_ENV=production                       # [API][WORKER]
API_PORT=4000                             # [API]  port the API listens on
API_HOST=0.0.0.0                          # [API]
LOG_LEVEL=info                            # [API][WORKER] fatal|error|warn|info|debug|trace

# ── Public origins ────────────────────────────────────────────────────────────
CORS_ORIGIN=https://www.tradelogs.com     # [API]  the web app's public origin (comma-separate if many)
APP_URL=https://www.tradelogs.com         # [API]  where emails/links point (falls back to CORS_ORIGIN)
AUTH_URL=https://api.tradelogs.com        # [API]  better-auth base URL (the API's own public URL)

# ── Database (Neon Postgres) ──────────────────────────────────────────────────
DATABASE_URL=postgresql://USER:PASS@HOST-pooler.neon.tech/db?sslmode=require   # [API] pooled
DIRECT_URL=postgresql://USER:PASS@HOST.neon.tech/db?sslmode=require            # [API] non-pooled (migrations)

# ── Auth ──────────────────────────────────────────────────────────────────────
AUTH_SECRET=CHANGE_ME_openssl_rand_hex_32     # [API]  session signing secret
CREDENTIAL_ENCRYPTION_KEY=CHANGE_ME_hex_32    # [API]  encrypts stored broker passwords — rotating invalidates them
GOOGLE_CLIENT_ID=                             # [API]  optional — Google OAuth
GOOGLE_CLIENT_SECRET=                         # [API]  optional — Google OAuth

# ── Transactional email (Resend) ──────────────────────────────────────────────
# Without RESEND_API_KEY, emails (verification OTP + weekly review) only log to
# the server console. Get a key at resend.com after verifying your sending domain.
RESEND_API_KEY=re_xxx                          # [API]
EMAIL_FROM=TRADElogs <hello@mail.tradelogs.com># [API]  sender at your verified domain

# ── MT5 bridge ────────────────────────────────────────────────────────────────
MT5_BRIDGE_URL=http://BRIDGE_HOST:8000         # [API]  the MetaTrader-5 bridge
MT5_BRIDGE_SHARED_SECRET=CHANGE_ME             # [API]

# ── AI coach (LLM via Groq, OpenAI-wire-compatible) ───────────────────────────
# Without AI_PROVIDER+key the coach falls back to rule-based insights (no LLM)
# and the dashboard AI report won't generate. Get a key at console.groq.com.
AI_PROVIDER=groq                               # [API]  groq | openai | none
GROQ_API_KEY=gsk_xxx                           # [API]  when AI_PROVIDER=groq
# OPENAI_API_KEY=sk-xxx                         # [API]  when AI_PROVIDER=openai
# AI_MODEL=                                     # [API]  optional override (default llama-3.3-70b-versatile)
# AI_BASE_URL=                                  # [API]  optional override

# ── Web search for the coach (Tavily) ─────────────────────────────────────────
# Optional. With a Tavily key the coach can answer current/market questions;
# without it, it stays grounded on the trader's own data. Get one at tavily.com.
TAVILY_API_KEY=tvly-xxx                         # [API]  optional
# SEARCH_PROVIDER=                              # [API]  tavily | compound | none (auto-resolved when unset)

# ── Queue / Redis ─────────────────────────────────────────────────────────────
# Required for the weekly-review worker. The API also uses it for rate limiting
# when present (falls back to in-memory otherwise). Add a Redis plugin in Railway.
REDIS_URL=redis://default:PASS@redis.railway.internal:6379   # [API optional][WORKER required]

# ── Background jobs: weekly AI review ─────────────────────────────────────────
# The worker schedules; the API executes (worker never touches the DB/bridge).
# INTERNAL_API_TOKEN must be the SAME value on both the API and Worker services.
INTERNAL_API_TOKEN=CHANGE_ME_openssl_rand_hex_32            # [API][WORKER] (>=16 chars)
API_INTERNAL_URL=http://api.railway.internal:4000           # [WORKER] the API's private URL
# WEEKLY_REVIEW_CRON=0 9 * * 6                               # [WORKER] default: Sat 09:00 UTC
# WEEKLY_REVIEW_CONCURRENCY=1                                # [WORKER] keep 1 (MT5 bridge serialises)
# WEEKLY_REVIEW_PER_MINUTE=6                                 # [WORKER] send rate cap

# ── Web app (Next.js) — set on the WEB service only ──────────────────────────
# NEXT_PUBLIC_API_URL=https://api.tradelogs.com              # [WEB]  the API's public URL
# NEXT_PUBLIC_USE_MOCKS=false                                # [WEB]  false = hit the real API

# ── Macro segment (global-macro intelligence dashboard) ──────────────────────
# FRED (free) drives the automated macro data — without it the MACRO segment is
# idle (empty state). Market prices are keyless (Binance) or reuse FINNHUB_API_KEY.
# FRED_API_KEY=your_fred_key                                 # [API][WORKER] free: fredaccount.stlouisfed.org
# MACRO_INGEST_CRON=*/30 * * * *                             # [WORKER] macro refresh cadence
# MACRO_STATE_CACHE_TTL=90                                   # [API] /api/macro/state cache seconds
# ANTHROPIC_API_KEY=sk-ant-...                               # [API] macro Claude assistant (later phase)
# MACRO_ADMIN_EMAILS=you@example.com                         # [API] allowed to approve macro members
