// Prisma schema — Phase 1 on Neon PostgreSQL.
// pgvector is enabled (Neon supports it).
// TimescaleDB removed for Phase 1 — Neon doesn't support it.
// Revisit at Phase 2 for candle/MAE/MFE storage (see task chip).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [vector]
}

// ─── Auth tables (better-auth managed) ───────────────────────────────────────

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Worldwide location (collected at signup / blocking modal)
  country           String?
  city              String?
  postalCode        String?
  lat               Float?
  lng               Float?
  locationUpdatedAt DateTime?

  /// Partner code typed into the signup form (raw, as entered). Attribution itself
  /// lives on Referral; this is kept for audit.
  referralCode String?

  /// Optional contact number (H8), as typed in E.164 form.
  phone            String?
  /// better-auth two-factor plugin (H5).
  twoFactorEnabled Boolean? @default(false)
  /// Product tour progress (H9): { seen: string[], dismissed: boolean }.
  tour             Json?

  sessions       Session[]
  accounts       Account[]
  brokerAccounts BrokerAccount[]
  partner        Partner?
  referral       Referral?

  exchangeConnections ExchangeConnection[]
  copyLeaders         CopyLeader[]
  copyFollows         CopyFollow[]
  exchangeOrders      ExchangeOrder[]

  telegramLink      TelegramLink?
  telegramLinkCodes TelegramLinkCode[]
  tradingWebhook    TradingWebhook?
  apiKeys           ApiKey[]
  indicatorAlerts   IndicatorAlert[]
  savedScreens      SavedScreen[]
  watchlistLists    WatchlistList[]
  strategies        Strategy[]   
  deployments       StrategyDeployment[]
  twoFactors        TwoFactor[]
  activity          ActivityEvent[]
  feedback          Feedback[]
  creatorProfile    CreatorProfile?
  templates         StrategyTemplate[]
  subscriptions     TemplateSubscription[]

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

/// TOTP secret and hashed backup codes for two-factor sign-in (better-auth plugin, H5).
model TwoFactor {
  id          String   @id @default(cuid())
  secret      String
  backupCodes String
  verified    Boolean? @default(true)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([secret])
  @@index([userId])
  @@map("two_factor")
}

/// The account's own activity log (H7): sign-ins, security changes, exchange
/// connections, follows. Orders are read from exchange_order alongside it.
model ActivityEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String
  summary   String
  ip        String?
  userAgent String?
  data      Json?
  at        DateTime @default(now())

  @@index([userId, at(sort: Desc)])
  @@map("activity_event")
}

/// Bug reports and feedback from the help page (H10). A person reads every one.
model Feedback {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String
  message   String
  page      String?
  userAgent String?
  status    String    @default("new")
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@map("feedback")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String   @db.Text
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ─── Broker tables (Phase 1) ──────────────────────────────────────────────────

model BrokerAccount {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  broker          String
  mt5Login        BigInt
  server          String
  password        String?
  baseCurrency    String        @default("USD")
  marginMode      MarginMode
  status          AccountStatus @default(ACTIVE)
  lastSyncAt      DateTime?
  /// Why the last sync failed (cleared on success / new credentials).
  lastSyncError   String?
  /// Cross-instance sync lock: a sync owns the account until this time.
  syncLockedUntil DateTime?
  /// Back-off after a failed sync: background syncs skip the account until then.
  syncRetryAt     DateTime?
  /// Bumped whenever a sync stores new deals — the cache key for derived trades/stats.
  dataVersion     Int           @default(0)
  /// Newest stored deal time; incremental syncs start a little before it.
  lastDealAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  syncRuns   SyncRun[]
  executions Execution[]
  trades     Trade[]

  @@unique([mt5Login, server])
  @@index([userId])
  @@index([lastSyncAt])
  @@map("broker_account")
}

enum MarginMode {
  NETTING
  HEDGING
}

enum AccountStatus {
  ACTIVE
  DISCONNECTED
  ERROR
}

// ─── Raw MT5 deals (immutable source of truth) ────────────────────────────────

model Execution {
  id              String        @id @default(cuid())
  brokerAccountId String
  brokerAccount   BrokerAccount @relation(fields: [brokerAccountId], references: [id], onDelete: Cascade)

  /// MT5 tickets are only unique per broker server, so uniqueness is per account.
  dealTicket  BigInt
  orderTicket BigInt
  positionId  BigInt
  symbol      String
  type        DealType
  entry       DealEntry
  volume      Decimal   @db.Decimal(18, 8)
  price       Decimal   @db.Decimal(18, 8)
  profit      Decimal   @db.Decimal(18, 8)
  commission  Decimal   @db.Decimal(18, 8)
  swap        Decimal   @db.Decimal(18, 8)
  fee         Decimal   @default(0) @db.Decimal(18, 8)
  dealTime    DateTime
  magic       Int       @default(0)
  comment     String?
  reason      Int       @default(0)
  externalId  String?

  tradeId String?
  trade   Trade?  @relation(fields: [tradeId], references: [id])

  createdAt DateTime @default(now())

  @@unique([brokerAccountId, dealTicket])
  @@index([brokerAccountId, dealTime])
  @@index([positionId])
  @@index([symbol])
  @@index([dealTime])
  @@map("execution")
}

enum DealType {
  BUY
  SELL
  BALANCE
}

enum DealEntry {
  IN
  OUT
  INOUT
  OUT_BY
}

// ─── Reconstructed trades ────────────────────────────────────────────────────

model Trade {
  id              String        @id @default(cuid())
  brokerAccountId String
  brokerAccount   BrokerAccount @relation(fields: [brokerAccountId], references: [id], onDelete: Cascade)

  symbol String
  side   TradeSide
  status TradeStatus @default(OPEN)

  openTime  DateTime
  closeTime DateTime?

  volume   Decimal  @db.Decimal(18, 8)
  avgEntry Decimal  @db.Decimal(18, 8)
  avgExit  Decimal? @db.Decimal(18, 8)

  grossPnl   Decimal @default(0) @db.Decimal(18, 8)
  commission Decimal @default(0) @db.Decimal(18, 8)
  swap       Decimal @default(0) @db.Decimal(18, 8)
  netPnl     Decimal @default(0) @db.Decimal(18, 8)

  riskAmount Decimal? @db.Decimal(18, 8)
  rMultiple  Decimal? @db.Decimal(18, 8)

  executions Execution[]
  metric     TradeMetric?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([brokerAccountId])
  @@index([symbol])
  @@index([openTime])
  @@index([status])
  @@map("trade")
}

model TradeMetric {
  id      String @id @default(cuid())
  tradeId String @unique
  trade   Trade  @relation(fields: [tradeId], references: [id], onDelete: Cascade)

  mae         Decimal? @db.Decimal(18, 8)
  mfe         Decimal? @db.Decimal(18, 8)
  captureRate Decimal? @db.Decimal(8, 4)
  durationSec Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("trade_metric")
}

enum TradeSide {
  BUY
  SELL
}

enum TradeStatus {
  OPEN
  CLOSED
}

// ─── Balance events (deposits / withdrawals) ──────────────────────────────────

model BalanceEvent {
  id              String   @id @default(cuid())
  brokerAccountId String
  ticket          BigInt   @unique
  amount          Decimal  @db.Decimal(18, 8)
  comment         String?
  eventTime       DateTime
  createdAt       DateTime @default(now())

  @@index([brokerAccountId])
  @@map("balance_event")
}

// ─── Journal entries ──────────────────────────────────────────────────────────

model JournalEntry {
  id              String  @id @default(cuid())
  userId          String
  brokerAccountId String?

  title   String?
  body    String   @db.Text
  emotion String?
  tags    String[]
  tradeId String?

  entryDate DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([brokerAccountId])
  @@index([entryDate])
  @@map("journal_entry")
}

// ─── Sync runs ────────────────────────────────────────────────────────────────

model SyncRun {
  id              String        @id @default(cuid())
  brokerAccountId String
  brokerAccount   BrokerAccount @relation(fields: [brokerAccountId], references: [id], onDelete: Cascade)

  status      SyncStatus @default(RUNNING)
  dealsPulled Int        @default(0)
  tradesBuilt Int        @default(0)
  error       String?
  startedAt   DateTime   @default(now())
  finishedAt  DateTime?

  @@index([brokerAccountId])
  @@map("sync_run")
}

enum SyncStatus {
  RUNNING
  DONE
  FAILED
}

// ─── AI coach conversations ───────────────────────────────────────────────────

model AiConversation {
  id              String  @id @default(cuid())
  userId          String
  brokerAccountId String?
  title           String?

  messages AiMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("ai_conversation")
}

model AiMessage {
  id             String         @id @default(cuid())
  conversationId String
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  role    AiRole
  content String @db.Text

  // Web-search citations the assistant used for this message (array of
  // {title,url,snippet}); null for personal answers and all pre-search messages.
  sources Json?
  // Router lane that produced this message ('personal' | 'web' | 'hybrid').
  // Nullable for observability only; null on legacy rows.
  lane    String?

  createdAt DateTime @default(now())

  @@index([conversationId])
  @@map("ai_message")
}

enum AiRole {
  user
  assistant
}

/// Opt-in for the weekly AI review email. One row per user (the email is a single
/// digest covering every account they have), created only when the user turns it
/// on, so an absent row means "not subscribed". Deliberately a separate table:
/// better-auth owns `user`, and this never touches it.
model WeeklyReviewSubscription {
  id      String  @id @default(cuid())
  userId  String  @unique
  /// Opt-in: false until the user explicitly enables it in settings.
  enabled Boolean @default(false)

  /// Cryptographically random, generated in application code (NOT a cuid — this
  /// appears in an unauthenticated unsubscribe link and must be unguessable).
  unsubscribeToken String @unique

  /// When the digest last went out. Also the idempotency guard: a job for a week
  /// that was already sent is a no-op, so a duplicate cron fire can't double-send.
  lastSentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enabled, lastSentAt])
  @@map("weekly_review_subscription")
}

/// Cached AI narrative for one account. Keyed on a hash of the trader-context it
/// was written from: while the hash matches, the stored narrative is reused and no
/// tokens are spent. One row per account (upserted), so the table stays bounded.
model AiReport {
  id              String @id @default(cuid())
  userId          String
  brokerAccountId String

  /// SHA-256 of the TraderContext used to generate `content`.
  dataHash String
  content  String  @db.Text
  /// Model that produced the narrative — for debugging drift after a model swap.
  model    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, brokerAccountId])
  @@index([userId])
  @@map("ai_report")
}

// ─── Phase 2: Economic Calendar + News (shared across all users) ──────────────
// These tables hold data fetched once by the ingestion pipeline and served to
// every user — never fetched per user request. Additive only; nothing here
// touches the better-auth `user` table.

enum EventImpact {
  LOW
  MEDIUM
  HIGH
}

/// One economic-calendar event, reconciled from one or more providers. The
/// `dedupKey` (currency|hour-bucket|normalized-title) makes ingestion idempotent
/// and lets several providers merge into a single row with per-field provenance.
model EconomicEvent {
  id        String      @id @default(cuid())
  dedupKey  String      @unique
  title     String
  country   String // ISO-3166 alpha-2, for the flag
  currency  String // e.g. USD, EUR
  category  String?
  impact    EventImpact @default(LOW)
  eventTime DateTime // always stored UTC

  // Result numbers are strings so units/signs ("%", "K", "-0.2") survive intact.
  actual   String?
  forecast String?
  previous String?
  unit     String?
  actualAt DateTime? // when `actual` was first observed — drives the live flash

  // Per-field provenance + each provider's raw values (same idea as AiMessage.sources).
  sources Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  watches EventWatch[]

  @@index([eventTime])
  @@index([currency, eventTime])
  @@index([impact, eventTime])
  @@map("economic_event")
}

enum NewsCategory {
  CRYPTO
  MACRO
  GEOPOLITICAL
  REGULATORY
  MARKETS
}

enum Sentiment {
  BULLISH
  BEARISH
  NEUTRAL
}

/// One news item, deduped across outlets. LLM-enrichment fields are nullable so
/// the feed serves fully even when AI is off (chips just hide).
model NewsItem {
  id          String        @id @default(cuid())
  dedupKey    String        @unique
  url         String
  title       String
  summary     String?       @db.Text
  source      String
  sources     Json? // "also reported by" cluster
  imageUrl    String?
  publishedAt DateTime
  country     String?
  category    NewsCategory?

  // LLM enrichment (null → un-enriched, still served).
  sentiment    Sentiment?
  relevance    Int? // 0..100
  impact       EventImpact? // HIGH == the red highlight
  marketMoving Boolean      @default(false)
  enrichedAt   DateTime?
  enrichHash   String? // content hash → skip re-enriching unchanged items

  createdAt DateTime @default(now())

  @@index([publishedAt])
  @@index([category, publishedAt])
  @@index([impact, publishedAt])
  @@map("news_item")
}

// ─── Phase 2: per-user preferences, watchlist, delivery ───────────────────────
// Per-user rows keyed by `userId` (no relation edit on the better-auth `user`
// table — same approach as JournalEntry / WeeklyReviewSubscription).

model NotificationPreference {
  id       String @id @default(cuid())
  userId   String @unique
  timezone String @default("UTC") // IANA tz for rendering + reminder math

  inApp Boolean @default(true)
  email Boolean @default(false)
  push  Boolean @default(false)

  minImpact   EventImpact @default(HIGH)
  currencies  String[] // empty = all
  categories  String[] // empty = all
  leadMinutes Int         @default(15)
  newsAlerts  Boolean     @default(false)
  priceAlerts Boolean     @default(true)
  /// Per-group email/push overrides, e.g. {"news":{"push":false}} (C6.6). Missing means on.
  groups      Json        @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("notification_preference")
}

/// A user's news-feed personalization. `sources` is the set of preferred outlet
/// keys (e.g. "rss:coindesk"); empty means "no preference" and the feed renders
/// as one unpersonalized list. When set, the feed splits: preferred sources on
/// top, everything else below.
model NewsPreference {
  id      String   @id @default(cuid())
  userId  String   @unique
  sources String[] // preferred outlet keys; empty = no preference

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("news_preference")
}

/// A user pinning a specific event for a reminder.
model EventWatch {
  id      String        @id @default(cuid())
  userId  String
  eventId String
  event   EconomicEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, eventId])
  @@index([userId])
  @@map("event_watch")
}

/// A Web Push endpoint (VAPID). Pruned when the browser reports it gone (404/410).
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("push_subscription")
}

/// A user's Telegram chat for alerts (C6.2). One chat per user, one user per chat.
model TelegramLink {
  id       String   @id @default(cuid())
  userId   String   @unique
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  chatId   String   @unique
  username String?
  linkedAt DateTime @default(now())

  @@map("telegram_link")
}

/// One-time code behind the t.me/<bot>?start=<code> link; expires after 15 minutes.
model TelegramLinkCode {
  code      String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("telegram_link_code")
}

/// The in-app notification-center inbox.
model Notification {
  id      String    @id @default(cuid())
  userId  String
  kind    String // "event_reminder" | "news_alert" | "actual_released"
  title   String
  body    String?   @db.Text
  href    String? // deep link
  eventId String?
  newsId  String?
  readAt  DateTime?
  /// Hidden from the inbox's main view; kept for the Archived tab (C6.5).
  archivedAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@map("notification")
}

/// Idempotency ledger — one row per (dedupKey, channel) guarantees no double-send.
model NotificationDelivery {
  id       String @id @default(cuid())
  userId   String
  dedupKey String // e.g. "reminder:<eventId>:<leadBucket>"
  channel  String // in_app | email | push

  createdAt DateTime @default(now())

  @@unique([dedupKey, channel])
  @@map("notification_delivery")
}

// ─── Advanced charting: durable candle store + per-user watchlist ─────────────

// Immutable historical bars, persisted for backfill/deep-history. The forming
// (latest) bar is served live over SSE and re-upserted as it closes. Shared
// across all users — keyed by symbol + timeframe + bar open time.
model Candle {
  symbol    String
  timeframe String // 1m | 5m | 15m | 30m | 1h | 4h | 1d | 1w | 1M
  openTime  DateTime
  open      Decimal  @db.Decimal(18, 8)
  high      Decimal  @db.Decimal(18, 8)
  low       Decimal  @db.Decimal(18, 8)
  close     Decimal  @db.Decimal(18, 8)
  volume    Decimal  @db.Decimal(24, 8)
  source    String // binance | mt5 | twelvedata

  @@id([symbol, timeframe, openTime])
  @@index([symbol, timeframe, openTime(sort: Desc)])
  @@map("candle")
}

// One row per user — the symbols they've pinned to their chart watchlist.
// Superseded by WatchlistList (QW.12); kept so nothing is lost. A user's first
// read of their lists copies this row into a list named "Watchlist".
model Watchlist {
  userId    String   @id
  symbols   String[]
  updatedAt DateTime @updatedAt

  @@map("watchlist")
}

/// A named watchlist (QW.12): up to 8 per user, names unique per user
/// (case-insensitive, enforced in the service), at least one always kept.
model WatchlistList {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  symbols   String[]
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
  @@index([userId, position])
  @@map("watchlist_list")
}

// A user's price alert: notify when `symbol` crosses `threshold`. Fires on a
// transition (tracked via lastPrice) — one-shot (status→triggered) or recurring
// (re-arms, fireSeq++ for a fresh idempotency slot).
model PriceAlert {
  id          String    @id @default(cuid())
  userId      String
  symbol      String
  accountId   String? // broker symbols route via the account's MT5 creds
  direction   String // "above" | "below"
  threshold   Decimal   @db.Decimal(18, 8)
  lastPrice   Decimal?  @db.Decimal(18, 8) // last observed price (cross detection)
  status      String    @default("active") // active | triggered | disabled
  recurring   Boolean   @default(false)
  fireSeq     Int       @default(0)
  note        String?
  triggeredAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, symbol])
  @@index([userId])
  @@map("price_alert")
}

// ─── Macro segment (global-macro intelligence dashboard) ─────────────────────
// Automated macro data (FRED) + market snapshots + engine outputs, all
// historized (snapshot per asOf) so we get trends / regime trail / backtests.

model MacroIndicator {
  id        String   @id @default(cuid())
  key       String // FRED series key, e.g. CPIAUCSL, WALCL, T10Y2Y
  label     String
  value     Decimal  @db.Decimal(24, 8)
  prev      Decimal? @db.Decimal(24, 8)
  forecast  Decimal? @db.Decimal(24, 8)
  unit      String?
  source    String // fred
  asOf      DateTime
  createdAt DateTime @default(now())

  @@unique([key, asOf])
  @@index([key, asOf(sort: Desc)])
  @@map("macro_indicator")
}

model MacroMarketQuote {
  id        String   @id @default(cuid())
  symbol    String // BTCUSDT, XAU, SPX, DXY
  price     Decimal  @db.Decimal(24, 8)
  changePct Decimal? @db.Decimal(12, 6)
  source    String
  asOf      DateTime
  createdAt DateTime @default(now())

  @@unique([symbol, asOf])
  @@index([symbol, asOf(sort: Desc)])
  @@map("macro_market_quote")
}

model BiasScore {
  id        String   @id @default(cuid())
  asset     String // BTC | XAU | SPX | DXY
  score     Int // 0-100
  label     String
  evidence  Json // { supporting: string[], opposing: string[] }
  engineVer String
  asOf      DateTime
  createdAt DateTime @default(now())

  @@index([asset, asOf(sort: Desc)])
  @@map("bias_score")
}

enum MacroMemberStatus {
  PENDING
  APPROVED
  REJECTED
}

model MacroMember {
  id          String            @id @default(cuid())
  userId      String            @unique // better-auth user id (no FK edit on User)
  exchange    String // DELTA | COINDCX | ...
  exchangeUid String
  status      MacroMemberStatus @default(PENDING)
  plan        String            @default("tradeai")
  expiresAt   DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([status])
  @@map("macro_member")
}

model MacroSignal {
  id           String   @id @default(cuid())
  asset        String
  direction    String // LONG | SHORT | WAIT
  entryLow     Decimal  @db.Decimal(24, 8)
  entryHigh    Decimal  @db.Decimal(24, 8)
  stop         Decimal  @db.Decimal(24, 8)
  t1           Decimal  @db.Decimal(24, 8)
  t2           Decimal  @db.Decimal(24, 8)
  t3           Decimal  @db.Decimal(24, 8)
  confidence   Int
  rationale    String   @db.Text
  invalidation String   @db.Text
  accountSize  Decimal  @default(100000) @db.Decimal(18, 2)
  qty          Decimal? @db.Decimal(24, 8)
  asOf         DateTime
  engineVer    String
  createdAt    DateTime @default(now())

  @@index([asset, asOf(sort: Desc)])
  @@map("macro_signal")
}

// On-demand Trader Master analysis. One row per analyze request. Levels are
// always engine-validated; `aiUsed` records whether an LLM wrote the narrative.
// Outcome fields are filled by the grading cron (triple-barrier vs later candles).
model TraderAnalysis {
  id               String   @id @default(cuid())
  userId           String? // null = anonymous / unauthenticated free use
  symbol           String
  assetClass       String
  timeframes       String[] // e.g. ["1h","4h"]
  direction        String // LONG | SHORT | WAIT
  entryLow         Decimal  @db.Decimal(24, 8)
  entryHigh        Decimal  @db.Decimal(24, 8)
  stop             Decimal  @db.Decimal(24, 8)
  t1               Decimal  @db.Decimal(24, 8)
  t2               Decimal  @db.Decimal(24, 8)
  t3               Decimal  @db.Decimal(24, 8)
  support          Json // [{ price, label }]
  resistance       Json // [{ price, label }]
  confidence       Int
  rationale        String   @db.Text
  invalidation     String   @db.Text
  detail           String   @db.Text
  perTimeframe     Json // [{ tf, trend, rsi, atr, note }]
  // Multi-lane breakdown once reconciler ships: [{ id, score, weight, rationale }]
  laneBreakdown    Json?
  // Meta-label feature snapshot at analyze time (for training / audit).
  featureSnapshot  Json?
  // heuristic | meta_v1 — how `confidence` was produced.
  confidenceSource String?
  rawConfidence    Int? // pre-calibration heuristic when meta overrides
  aiUsed           Boolean  @default(false)
  asOf             DateTime
  engineVer        String
  createdAt        DateTime @default(now())

  // Triple-barrier grading — null until the grader resolves a terminal outcome.
  // TARGET_HIT | STOP_HIT | EXPIRED | SKIPPED (WAIT never graded as a trade).
  outcome     String?
  hitLevel    String? // T1 | T2 | T3 when TARGET_HIT
  gradedAt    DateTime?
  horizonBars Int?
  horizonTf   String?
  mfePct      Float? // max favorable excursion % from entry mid
  maePct      Float? // max adverse excursion % from entry mid

  @@index([symbol, asOf(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([outcome, asOf])
  @@map("trader_analysis")
}

// Plain-English → compiled rules → backtest (Phase 4 strategy builder).
model TraderStrategy {
  id           String   @id @default(cuid())
  userId       String
  name         String
  prompt       String   @db.Text
  rules        Json // typed rule object from LLM parse
  status       String   @default("draft") // draft | paper | archived
  lastBacktest Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId, createdAt(sort: Desc)])
  @@index([status])
  @@map("trader_strategy")
}

// Paper book for a promoted strategy. Educational fills only — never a broker order.
model TraderPaperPosition {
  id           String    @id @default(cuid())
  strategyId   String
  userId       String
  symbol       String
  timeframe    String
  side         String // LONG | SHORT
  entry        Decimal   @db.Decimal(24, 8)
  stop         Decimal   @db.Decimal(24, 8)
  target       Decimal   @db.Decimal(24, 8)
  status       String    @default("open") // open | target | stop | expired
  entryBarTime DateTime
  exit         Decimal?  @db.Decimal(24, 8)
  exitBarTime  DateTime?
  mfePct       Float?
  maePct       Float?
  pnlPct       Float?
  openedAt     DateTime  @default(now())
  closedAt     DateTime?

  @@unique([strategyId, symbol, entryBarTime])
  @@index([status, strategyId])
  @@index([userId, openedAt(sort: Desc)])
  @@map("trader_paper_position")
}

// ─── Platform access control + admin ─────────────────────────────────────────

enum AccessSource {
  MANUAL_GRANT
  ELEFIN_VERIFIED
}

enum ElefinStatus {
  PENDING
  VERIFIED
  FAILED
}

enum ActivityStatus {
  UNKNOWN
  ACTIVE
  INACTIVE
}

/// Manual email whitelist — admin-granted full bypass with audit note.
model AccessGrant {
  id             String    @id @default(cuid())
  email          String    @unique
  note           String    @db.Text
  grantedBy      String
  grantedByEmail String
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  @@index([revokedAt])
  @@map("access_grant")
}

/// Per-user platform access state (better-auth user id, no FK on User).
model UserAccess {
  id                String         @id @default(cuid())
  userId            String         @unique
  source            AccessSource?
  elefinStatus      ElefinStatus   @default(PENDING)
  elefinUid         String?
  elefinVerifiedAt  DateTime?
  activityStatus    ActivityStatus @default(UNKNOWN)
  tradeCount7d      Int            @default(0)
  activityCheckedAt DateTime?
  lastDeniedReason  String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([elefinStatus])
  @@index([activityStatus])
  @@map("user_access")
}

/// Key-value system settings (maintenance mode, etc.).
model SystemSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
  updatedBy String?

  @@map("system_setting")
}

/// Admin action audit trail.
model AdminAuditLog {
  id         String   @id @default(cuid())
  action     String
  actorId    String
  actorEmail String
  targetType String?
  targetId   String?
  details    Json?
  createdAt  DateTime @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([actorId])
  @@map("admin_audit_log")
}

/// Product dwell-time session (heartbeat-based, separate from auth Session).
model UsageSession {
  id          String    @id @default(cuid())
  userId      String
  startedAt   DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  endedAt     DateTime?
  durationSec Int       @default(0)
  pagePath    String?
  userAgent   String?

  @@index([userId, startedAt])
  @@index([userId, endedAt, lastSeenAt])
  @@index([lastSeenAt])
  @@map("usage_session")
}

/// Product analytics events (page views, features, heartbeats).
model UsageEvent {
  id        String   @id @default(cuid())
  userId    String
  sessionId String?
  type      String
  path      String?
  feature   String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([type, createdAt])
  @@index([feature, createdAt])
  @@map("usage_event")
}

// ─── Partner programme (referral tracking only — no money) ─────────────────────

enum PartnerStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REVOKED
}

enum ReferralSource {
  LINK
  CODE
  ADMIN
}

/// A TRADElogs user who refers others. One per user.
model Partner {
  id          String        @id @default(cuid())
  userId      String        @unique
  status      PartnerStatus @default(PENDING)
  audience    String?
  approvedAt  DateTime?
  suspendedAt DateTime?
  revokedAt   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  codes     PartnerCode[]
  channels  PartnerChannel[]
  clicks    ReferralClick[]
  referrals Referral[]
  notes     PartnerNote[]

  @@index([status])
  @@map("partner")
}

/// Codes a partner holds. Every code attributes the same way. Exactly one primary,
/// generated on creation; custom codes can be released (row deleted).
model PartnerCode {
  id        String   @id @default(cuid())
  partnerId String
  /// Normalised upper-case, 3–20 of A-Z 0-9 _ -.
  code      String   @unique
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId])
  @@map("partner_code")
}

/// A tracked link variant (?ch=slug) so partners can see which post or group works.
model PartnerChannel {
  id         String    @id @default(cuid())
  partnerId  String
  label      String
  slug       String
  archivedAt DateTime?
  createdAt  DateTime  @default(now())

  partner   Partner         @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  clicks    ReferralClick[]
  referrals Referral[]

  @@unique([partnerId, slug])
  @@map("partner_channel")
}

/// One visit through a referral link. IPs are stored only as a salted hash.
model ReferralClick {
  id              String   @id @default(cuid())
  partnerId       String
  channelId       String?
  code            String
  ipHash          String
  device          String
  country         String?
  referrer        String?
  convertedUserId String?  @unique
  createdAt       DateTime @default(now())

  partner Partner         @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  channel PartnerChannel? @relation(fields: [channelId], references: [id], onDelete: SetNull)

  @@index([partnerId, createdAt])
  @@index([ipHash, createdAt])
  @@map("referral_click")
}

/// The partner a user belongs to. Set once at account creation (or by an admin) and
/// carries a refreshed activity snapshot so partner dashboards never hit the MT5 bridge.
model Referral {
  id           String         @id @default(cuid())
  userId       String         @unique
  partnerId    String
  channelId    String?
  code         String
  source       ReferralSource
  clickId      String?
  attributedAt DateTime       @default(now())

  connectedAt    DateTime?
  firstActiveAt  DateTime?
  inactiveAt     DateTime?
  isActive       Boolean   @default(false)
  tradeCount7d   Int       @default(0)
  trades30d      Int       @default(0)
  lots30d        Float     @default(0)
  lastTradeAt    DateTime?
  statsCheckedAt DateTime?
  statsError     String?

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  partner Partner         @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  channel PartnerChannel? @relation(fields: [channelId], references: [id], onDelete: SetNull)

  @@index([partnerId, attributedAt])
  @@index([statsCheckedAt])
  @@map("referral")
}

/// Admin note trail on a partner ("context for whoever picks this up next").
model PartnerNote {
  id          String   @id @default(cuid())
  partnerId   String
  authorId    String
  authorEmail String
  body        String   @db.Text
  createdAt   DateTime @default(now())

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId, createdAt])
  @@map("partner_note")
}

/// Names no partner may take as a code (beyond the built-in list in the API).
model ReservedPartnerCode {
  id             String   @id @default(cuid())
  code           String   @unique
  reason         String?
  createdById    String
  createdByEmail String
  createdAt      DateTime @default(now())

  @@map("reserved_partner_code")
}

// ─── Trading platform (Part B): exchange connections, copy trading, orders ──
// Ported from MirrorPip-X and generalised; see reports/mpx-port-notes.md.
// Exchange API keys are stored with apps/api/src/lib/secrets.ts ("enc:v1:").

enum ExchangeVenue {
  DELTA_INDIA
}

/// Testnet and live keys are different keys on different hosts; never mixed.
enum ExchangeEnvironment {
  TESTNET
  LIVE
}

enum ExchangeConnectionStatus {
  ACTIVE
  INVALID // the exchange rejected the key; user must reconnect
  REVOKED // removed by the user; secrets wiped
}

enum CopyLeaderStatus {
  PENDING // applied, awaiting admin review
  VERIFIED // live and followable
  PAUSED // temporarily not copying
  DELISTED // hidden
}

enum CopyFollowStatus {
  ACTIVE
  PAUSED
  STOPPED
}

enum CopySizingMode {
  PROPORTIONAL // leader qty × (follower equity / leader equity) × value
  FIXED_NOTIONAL // value USD of notional per leader entry
  MULTIPLIER // leader qty × value
}

enum ExchangeOrderSide {
  BUY
  SELL
}

enum ExchangeOrderType {
  MARKET
  LIMIT
  STOP_MARKET
  STOP_LIMIT
  TAKE_PROFIT_MARKET
  TAKE_PROFIT_LIMIT
}

enum ExchangeOrderStatus {
  PENDING // claimed by us, not yet sent
  SUBMITTED // sent, outcome unknown
  OPEN
  PARTIAL
  FILLED
  CANCELLED
  REJECTED
  SKIPPED // never sent: risk limit, kill switch, size rounded to zero
  EXPIRED
}

enum ExchangeOrderSource {
  MANUAL
  COPY
  STRATEGY
  WEBHOOK
}

enum PositionDirection {
  LONG
  SHORT
}

model ExchangeConnection {
  id          String              @id @default(cuid())
  userId      String
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  exchange    ExchangeVenue
  environment ExchangeEnvironment
  label       String

  apiKeyEnc      String
  apiSecretEnc   String
  passphraseEnc  String?
  /// Last 4 characters of the public key, for display.
  keyLast4       String
  /// HMAC of the key (see @tradinjournal/exchange fingerprintApiKey); detects duplicates without decrypting.
  keyFingerprint String
  /// The exchange's own account id, the same across every key of one account.
  accountRef     String?
  canTrade       Boolean                  @default(false)
  status         ExchangeConnectionStatus @default(ACTIVE)
  lastError      String?
  lastCheckedAt  DateTime?
  /// Newest point the trade-history import has reached (D18); null before the first import.
  historySyncedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leader    CopyLeader?
  follows   CopyFollow[]
  orders    ExchangeOrder[]
  positions ExchangePosition[]
  fills     ExchangeFill[]
  webhooks  TradingWebhook[]

  @@index([userId, status])
  @@index([exchange, environment, keyFingerprint])
  @@index([exchange, environment, accountRef])

  @@map("exchange_connection")
}

model CopyLeader {
  id           String             @id @default(cuid())
  userId       String
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The account we watch for this leader's fills.
  connectionId String             @unique
  connection   ExchangeConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  displayName  String
  bio          String?
  status       CopyLeaderStatus   @default(PENDING)
  /// Leader opts in to appearing on the public leaderboard.
  listed       Boolean            @default(true)
  maxFollowers Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  follows      CopyFollow[]
  fills        LeaderFill[]
  equityPoints LeaderEquityPoint[]
  stats        LeaderStat[]

  @@index([status, listed])
  @@map("copy_leader")
}

/// Leader account equity over time. Written at most every 5 minutes per leader.
model LeaderEquityPoint {
  id        String     @id @default(cuid())
  leaderId  String
  leader    CopyLeader @relation(fields: [leaderId], references: [id], onDelete: Cascade)
  equityUsd Decimal    @db.Decimal(20, 2)
  ts        DateTime   @default(now())

  @@index([leaderId, ts])
  @@map("leader_equity_point")
}

model LeaderStat {
  id             String     @id @default(cuid())
  leaderId       String
  leader         CopyLeader @relation(fields: [leaderId], references: [id], onDelete: Cascade)
  window         String // "7d" | "30d" | "all"
  roiPct         Decimal    @default(0) @db.Decimal(12, 4)
  winRatePct     Decimal?   @db.Decimal(6, 2)
  /// Share of winning-trade profit from the 3 best closed trades in the window; null under 5 trades (C2.3).
  top3ProfitSharePct Decimal? @db.Decimal(6, 2)
  /// Leader round trips closed in the window, rebuilt from fills.
  closedTradeCount   Int?
  maxDrawdownPct Decimal    @default(0) @db.Decimal(6, 2)
  totalCopiedUsd Decimal    @default(0) @db.Decimal(20, 2)
  tradeCount     Int        @default(0)
  followerCount  Int        @default(0)
  updatedAt      DateTime   @updatedAt

  @@unique([leaderId, window])
  @@map("leader_stat")
}

model CopyFollow {
  id           String             @id @default(cuid())
  userId       String
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  leaderId     String
  leader       CopyLeader         @relation(fields: [leaderId], references: [id], onDelete: Cascade)
  /// The follower's own account that copies are placed on.
  connectionId String
  connection   ExchangeConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  sizingMode        CopySizingMode @default(PROPORTIONAL)
  sizingValue       Decimal        @default(1) @db.Decimal(20, 8)
  /// Leverage set on the follower's contracts before copying; null keeps the account's.
  leverage          Int?
  maxPositionUsd    Decimal?       @db.Decimal(20, 2)
  /// Realized + unrealized loss since the start of the day that pauses this follow.
  dailyLossLimitUsd Decimal?       @db.Decimal(20, 2)
  /// Total P&L since startedAt (realized + unrealized) that pauses this follow.
  maxProfitUsd      Decimal?       @db.Decimal(20, 2)
  copyReverse       Boolean        @default(false)
  /// Per-symbol unsent size in venue units, carried between fills ({"BTCUSD": 0.4}).
  residuals         Json           @default("{}")

  status      CopyFollowStatus @default(ACTIVE)
  /// Copy-from-now: fills before this are never copied.
  startedAt   DateTime         @default(now())
  pausedAt    DateTime?
  pauseReason String?
  stoppedAt   DateTime?
  /// Risk disclosure the follower accepted, and when (C3.6).
  riskAcceptedAt DateTime?
  riskVersion    String?
  /// Set when the follower asked to copy the leader's open trades on start (C1.11); the engine clears it once done.
  copyOpenRequestedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders    ExchangeOrder[]
  positions ExchangePosition[]

  @@unique([userId, leaderId])
  @@index([leaderId, status])
  @@index([connectionId])
  @@map("copy_follow")
}

model LeaderFill {
  id            String            @id @default(cuid())
  leaderId      String
  leader        CopyLeader        @relation(fields: [leaderId], references: [id], onDelete: Cascade)
  /// Exchange fill id; makes ingestion idempotent.
  externalId    String
  symbol        String
  side          ExchangeOrderSide
  qty           Decimal           @db.Decimal(30, 10)
  price         Decimal           @db.Decimal(30, 10)
  reduceOnly    Boolean           @default(false)
  /// Leader's signed position on the symbol after this fill, when the venue reports it.
  positionAfter Decimal?          @db.Decimal(30, 10)
  exchTs        DateTime
  ingestedAt    DateTime          @default(now())

  orders ExchangeOrder[]

  @@unique([leaderId, externalId])
  @@index([leaderId, exchTs])
  @@index([exchTs])
  @@map("leader_fill")
}

/// Every order we send (or decide not to send) on a user's exchange account.
model ExchangeOrder {
  id           String              @id @default(cuid())
  userId       String
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  connectionId String
  connection   ExchangeConnection  @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  source       ExchangeOrderSource
  followId     String?
  follow       CopyFollow?         @relation(fields: [followId], references: [id], onDelete: SetNull)
  leaderFillId String?
  leaderFill   LeaderFill?         @relation(fields: [leaderFillId], references: [id], onDelete: SetNull)

  /// Our idempotency key; one order per (follow, leader fill) for copies.
  clientOrderId   String              @unique
  exchangeOrderId String?
  symbol          String
  side            ExchangeOrderSide
  type            ExchangeOrderType
  timeInForce     String?
  reduceOnly      Boolean             @default(false)
  qty             Decimal             @db.Decimal(30, 10)
  limitPrice      Decimal?            @db.Decimal(30, 10)
  stopPrice       Decimal?            @db.Decimal(30, 10)
  status          ExchangeOrderStatus @default(PENDING)
  filledQty       Decimal             @default(0) @db.Decimal(30, 10)
  avgFillPrice    Decimal?            @db.Decimal(30, 10)
  /// Leader's fill price, for slippage on copies.
  leaderPrice     Decimal?            @db.Decimal(30, 10)
  slippageBps     Decimal?            @db.Decimal(12, 4)
  fees            Decimal?            @db.Decimal(20, 8)
  /// P&L this order booked by reducing a position (copies), for the daily loss limit.
  realizedPnl     Decimal?            @db.Decimal(20, 2)
  errorCode       String?
  error           String?

  requestedAt DateTime  @default(now())
  submittedAt DateTime?
  filledAt    DateTime?
  updatedAt   DateTime  @updatedAt

  fills ExchangeFill[]

  @@unique([connectionId, exchangeOrderId])
  @@index([followId, requestedAt])
  @@index([connectionId, status])
  @@index([leaderFillId])
  @@index([userId, requestedAt])
  @@index([followId, filledAt])
  @@map("exchange_order")
}

/// Net position per account, symbol and owner (a follow, or "manual").
model ExchangePosition {
  id              String              @id @default(cuid())
  connectionId    String
  connection      ExchangeConnection  @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  followId        String?
  follow          CopyFollow?         @relation(fields: [followId], references: [id], onDelete: SetNull)
  /// followId, or "manual"; keeps the unique key non-null.
  positionKey     String
  source          ExchangeOrderSource
  symbol          String
  side            PositionDirection
  qty             Decimal             @db.Decimal(30, 10)
  avgEntry        Decimal             @db.Decimal(30, 10)
  markPrice       Decimal?            @db.Decimal(30, 10)
  unrealizedPnl   Decimal             @default(0) @db.Decimal(20, 2)
  realizedPnl     Decimal             @default(0) @db.Decimal(20, 2)
  /// Size the exchange reports, for drift checks against qty.
  exchangeQty     Decimal?            @db.Decimal(30, 10)
  driftDetectedAt DateTime?

  openedAt  DateTime  @default(now())
  closedAt  DateTime?
  updatedAt DateTime  @updatedAt

  @@unique([connectionId, symbol, positionKey])
  @@index([followId])
  @@index([closedAt])
  @@map("exchange_position")
}

/// Executions on a connected account (ours and the user's own), for history and the journal.
model ExchangeFill {
  id              String             @id @default(cuid())
  connectionId    String
  connection      ExchangeConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  externalId      String
  orderId         String?
  order           ExchangeOrder?     @relation(fields: [orderId], references: [id], onDelete: SetNull)
  exchangeOrderId String?
  symbol          String
  side            ExchangeOrderSide
  qty             Decimal            @db.Decimal(30, 10)
  price           Decimal            @db.Decimal(30, 10)
  fee             Decimal?           @db.Decimal(20, 8)
  /// Signed position after the fill, worked out at import from the live position (D18).
  positionAfter   Decimal?           @db.Decimal(30, 10)
  /// Contract size at import, so P&L can be priced in USD without asking the venue again.
  contractMultiplier Decimal?        @db.Decimal(30, 12)
  exchTs          DateTime
  ingestedAt      DateTime           @default(now())

  @@unique([connectionId, externalId])
  @@index([connectionId, exchTs])
  @@index([orderId])
  @@map("exchange_fill")
}

/// TradingView alerts → orders (D14). One per user; the token is public (in the URL), the secret isn't stored.
model TradingWebhook {
  id            String             @id @default(cuid())
  userId        String             @unique
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  connectionId  String
  connection    ExchangeConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  token         String             @unique
  /// sha256 of the secret; compared in constant time.
  secretHash    String
  secretLast4   String
  enabled       Boolean            @default(true)
  /// The user ticked "this account is real money" for unattended orders.
  liveConfirmed Boolean            @default(false)
  createdAt     DateTime           @default(now())
  rotatedAt     DateTime           @default(now())

  events TradingWebhookEvent[]

  @@index([connectionId])
  @@map("trading_webhook")
}

/// Every request a webhook received and what came of it (D15).
model TradingWebhookEvent {
  id         String         @id @default(cuid())
  webhookId  String
  webhook    TradingWebhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  receivedAt DateTime       @default(now())
  ip         String?
  /// rejected | ordered | failed | duplicate
  status     String
  reason     String?
  alertId    String?
  /// The message with the secret removed.
  payload    Json?
  orderId    String?

  @@index([webhookId, receivedAt])
  @@map("trading_webhook_event")
}

/// Personal API keys for the /api/v1 trading API (D16). The secret is shown once; only its hash is kept.
model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  /// Public part of the key ("tl_<prefix>_..."), used to look it up.
  prefix     String    @unique
  secretHash String
  last4      String
  /// "read" or "trade" (trade includes read).
  scope      String
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@map("api_key")
}

/// An alert on an indicator condition, checked once per closed bar (E3).
model IndicatorAlert {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbol      String
  timeframe   String // 5m | 15m | 1h | 4h | 1d
  /// {kind:'indicator', id, output, params}
  left        Json
  /// gt | gte | lt | lte | eq | crosses_above | crosses_below
  operator    String
  /// {kind:'indicator', ...} or {kind:'value', value}
  right       Json
  cooldownSec Int       @default(3600)
  recurring   Boolean   @default(true)
  /// active | paused | triggered
  status      String    @default("active")
  note        String?
  /// Open time of the last closed bar evaluated; a bar is never evaluated twice.
  lastBarTime DateTime?
  lastLeft    Float?
  lastRight   Float?
  lastFiredAt DateTime?
  fireSeq     Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  firings IndicatorAlertFiring[]

  @@index([status, symbol, timeframe])
  @@index([userId])
  @@map("indicator_alert")
}

/// Each time an indicator alert fired, for "recent firings" (E4).
model IndicatorAlertFiring {
  id        String         @id @default(cuid())
  alertId   String
  alert     IndicatorAlert @relation(fields: [alertId], references: [id], onDelete: Cascade)
  firedAt   DateTime       @default(now())
  barTime   DateTime
  leftValue Float
  rightValue Float

  @@index([alertId, firedAt])
  @@map("indicator_alert_firing")
}

/// A screener definition a user saved (E5): timeframe, universe, filter groups, columns, sort.
model SavedScreen {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  definition Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
  @@map("saved_screen")
}

/// A strategy in the v2 spec (F1): builder, backtests and deployments read the
/// same document. Trader Master strategies are imported once (legacyId).
model Strategy {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name               String
  description        String?
  spec               Json
  /// draft | paper | live | paused | archived
  status             String   @default("draft")
  /// manual | ai | legacy | template (a private copy made by subscribing; its rules aren't shown)
  source             String   @default("manual")
  legacyId           String?  @unique
  version            Int      @default(1)
  baselineBacktestId String?
  /// For source=template: the marketplace template it was copied from.
  templateId         String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  versions      StrategyVersion[]
  backtests     StrategyBacktest[]
  deployments   StrategyDeployment[]
  /// Templates published from this strategy.
  templates     StrategyTemplate[]     @relation("TemplateSource")
  subscriptions TemplateSubscription[]

  @@index([userId, updatedAt(sort: Desc)])
  @@map("strategy")
}

/// Every saved edit of a strategy's rules (F19).
model StrategyVersion {
  id         String   @id @default(cuid())
  strategyId String
  strategy   Strategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  version    Int
  spec       Json
  note       String?
  createdAt  DateTime @default(now())

  @@unique([strategyId, version])
  @@map("strategy_version")
}

/// A backtest run (F12-F14). `hash` covers the spec, parameters and data range.
model StrategyBacktest {
  id         String   @id @default(cuid())
  strategyId String
  strategy   Strategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  userId     String
  version    Int
  params     Json
  metrics    Json
  result     Json
  hash       String
  createdAt  DateTime @default(now())

  @@index([strategyId, createdAt(sort: Desc)])
  @@index([hash])
  @@map("strategy_backtest")
}

/// A strategy running on paper or live (F15-F18). The spec is a frozen copy of
/// one version, so later edits never change what's running.
model StrategyDeployment {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  strategyId      String
  strategy        Strategy  @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  version         Int
  spec            Json
  name            String
  /// paper | live
  mode            String
  connectionId    String?
  /// running | paused | stopped | errored | archived
  status          String    @default("running")
  capital         Float
  /// [{from, multiplier}]: size changes apply from their time on
  sizeSchedule    Json      @default("[]")
  /// [{from, to}]: paused periods, no new entries
  pauses          Json      @default("[]")
  startedAt       DateTime  @default(now())
  stoppedAt       DateTime?
  stopReason      String?
  lastEvaluatedAt DateTime?
  lastBarTime     DateTime?
  error           String?
  /// Paper: latest replay (metrics, open positions, equity). Live: runner state.
  snapshot        Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  trades DeploymentTrade[]
  events DeploymentEvent[]

  @@index([userId, status])
  @@index([status, mode])
  @@map("strategy_deployment")
}

model DeploymentTrade {
  id           String             @id @default(cuid())
  deploymentId String
  deployment   StrategyDeployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  symbol       String
  side         String
  qty          Float
  entryPrice   Float
  entryTime    DateTime
  exitPrice    Float
  exitTime     DateTime
  pnl          Float
  pnlPct       Float
  fees         Float
  rMultiple    Float?
  reason       String

  @@unique([deploymentId, symbol, entryTime])
  @@index([deploymentId, exitTime])
  @@map("deployment_trade")
}

/// The activity feed (F18): each evaluation and action, with the reason.
model DeploymentEvent {
  id           String             @id @default(cuid())
  deploymentId String
  deployment   StrategyDeployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  at           DateTime
  symbol       String?
  kind         String
  message      String
  data         Json?
  createdAt    DateTime           @default(now())

  @@index([deploymentId, at(sort: Desc)])
  @@map("deployment_event")
}

// ── Marketplace (H1–H3) ───────────────────────────────────────────────────────

/// Someone who publishes strategy templates. An admin approves the application.
model CreatorProfile {
  id          String    @id @default(cuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName String
  bio         String
  experience  String?
  links       String[]
  /// pending | approved | rejected | suspended
  status      String    @default("pending")
  reviewNote  String?
  reviewedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status])
  @@map("creator_profile")
}

/// A published strategy: a frozen copy of the creator's rules (kept private),
/// the settings subscribers may tune, and performance computed by TRADElogs.
model StrategyTemplate {
  id                String    @id @default(cuid())
  creatorId         String
  creator           User      @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  strategyId        String?
  strategy          Strategy? @relation("TemplateSource", fields: [strategyId], references: [id], onDelete: SetNull)
  version           Int
  spec              Json
  name              String
  summary           String
  description       String
  /// trend | reversion | breakout | momentum | range | scalping
  category          String
  /// low | medium | high
  risk              String
  /// [{ id, path, label, min, max, step, value }]
  params            Json      @default("[]")
  /// Venues it may run on live, e.g. ["delta_india"].
  exchanges         String[]
  symbols           String[]
  interval          String
  /// pending | published | rejected | unlisted
  status            String    @default("pending")
  reviewNote        String?
  /// The creator's own run shown as its track record (paper or live).
  trackDeploymentId String?
  /// { backtest: { from, to, metrics, equity }, computedAt }
  performance       Json?
  publishedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  subscriptions TemplateSubscription[]

  @@index([status, publishedAt])
  @@index([creatorId])
  @@map("strategy_template")
}

/// A subscriber running a template: a private strategy copy and its deployment.
model TemplateSubscription {
  id           String            @id @default(cuid())
  userId       String
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Null once the creator removes the template; the subscriber's run carries on.
  templateId   String?
  template     StrategyTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  strategyId   String
  strategy     Strategy          @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  deploymentId String?           @unique
  /// The tuned settings: { [paramId]: value }.
  params       Json              @default("{}")
  /// active | paused | cancelled
  status       String            @default("active")
  cancelledAt  DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([userId, createdAt(sort: Desc)])
  @@index([templateId, status])
  @@map("template_subscription")
}
