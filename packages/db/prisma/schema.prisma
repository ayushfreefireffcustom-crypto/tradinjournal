// Prisma schema — Phase 1 on Neon PostgreSQL.
// pgvector is enabled (Neon supports it).
// TimescaleDB removed for Phase 1 — Neon doesn't support it.
// Revisit at Phase 2 for candle/MAE/MFE storage (see task chip).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [vector]
}

// ─── Auth tables (better-auth managed) ───────────────────────────────────────

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions       Session[]
  accounts       Account[]
  brokerAccounts BrokerAccount[]

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String   @db.Text
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ─── Broker tables (Phase 1) ──────────────────────────────────────────────────

model BrokerAccount {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  broker       String
  mt5Login     BigInt
  server       String
  password     String?
  baseCurrency String        @default("USD")
  marginMode   MarginMode
  status       AccountStatus @default(ACTIVE)
  lastSyncAt   DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  syncRuns   SyncRun[]
  executions Execution[]
  trades     Trade[]

  @@unique([mt5Login, server])
  @@index([userId])
  @@map("broker_account")
}

enum MarginMode {
  NETTING
  HEDGING
}

enum AccountStatus {
  ACTIVE
  DISCONNECTED
  ERROR
}

// ─── Raw MT5 deals (immutable source of truth) ────────────────────────────────

model Execution {
  id              String        @id @default(cuid())
  brokerAccountId String
  brokerAccount   BrokerAccount @relation(fields: [brokerAccountId], references: [id], onDelete: Cascade)

  dealTicket  BigInt    @unique
  orderTicket BigInt
  positionId  BigInt
  symbol      String
  type        DealType
  entry       DealEntry
  volume      Decimal   @db.Decimal(18, 8)
  price       Decimal   @db.Decimal(18, 8)
  profit      Decimal   @db.Decimal(18, 8)
  commission  Decimal   @db.Decimal(18, 8)
  swap        Decimal   @db.Decimal(18, 8)
  fee         Decimal   @default(0) @db.Decimal(18, 8)
  dealTime    DateTime
  magic       Int       @default(0)
  comment     String?
  reason      Int       @default(0)
  externalId  String?

  tradeId String?
  trade   Trade?  @relation(fields: [tradeId], references: [id])

  createdAt DateTime @default(now())

  @@index([brokerAccountId])
  @@index([positionId])
  @@index([symbol])
  @@index([dealTime])
  @@map("execution")
}

enum DealType {
  BUY
  SELL
  BALANCE
}

enum DealEntry {
  IN
  OUT
  INOUT
  OUT_BY
}

// ─── Reconstructed trades ────────────────────────────────────────────────────

model Trade {
  id              String        @id @default(cuid())
  brokerAccountId String
  brokerAccount   BrokerAccount @relation(fields: [brokerAccountId], references: [id], onDelete: Cascade)

  symbol String
  side   TradeSide
  status TradeStatus @default(OPEN)

  openTime  DateTime
  closeTime DateTime?

  volume   Decimal  @db.Decimal(18, 8)
  avgEntry Decimal  @db.Decimal(18, 8)
  avgExit  Decimal? @db.Decimal(18, 8)

  grossPnl   Decimal @default(0) @db.Decimal(18, 8)
  commission Decimal @default(0) @db.Decimal(18, 8)
  swap       Decimal @default(0) @db.Decimal(18, 8)
  netPnl     Decimal @default(0) @db.Decimal(18, 8)

  riskAmount Decimal? @db.Decimal(18, 8)
  rMultiple  Decimal? @db.Decimal(18, 8)

  executions Execution[]
  metric     TradeMetric?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([brokerAccountId])
  @@index([symbol])
  @@index([openTime])
  @@index([status])
  @@map("trade")
}

model TradeMetric {
  id      String @id @default(cuid())
  tradeId String @unique
  trade   Trade  @relation(fields: [tradeId], references: [id], onDelete: Cascade)

  mae         Decimal? @db.Decimal(18, 8)
  mfe         Decimal? @db.Decimal(18, 8)
  captureRate Decimal? @db.Decimal(8, 4)
  durationSec Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("trade_metric")
}

enum TradeSide {
  BUY
  SELL
}

enum TradeStatus {
  OPEN
  CLOSED
}

// ─── Balance events (deposits / withdrawals) ──────────────────────────────────

model BalanceEvent {
  id              String   @id @default(cuid())
  brokerAccountId String
  ticket          BigInt   @unique
  amount          Decimal  @db.Decimal(18, 8)
  comment         String?
  eventTime       DateTime
  createdAt       DateTime @default(now())

  @@index([brokerAccountId])
  @@map("balance_event")
}

// ─── Journal entries ──────────────────────────────────────────────────────────

model JournalEntry {
  id              String  @id @default(cuid())
  userId          String
  brokerAccountId String?

  title   String?
  body    String   @db.Text
  emotion String?
  tags    String[]
  tradeId String?

  entryDate DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([brokerAccountId])
  @@index([entryDate])
  @@map("journal_entry")
}

// ─── Sync runs ────────────────────────────────────────────────────────────────

model SyncRun {
  id              String        @id @default(cuid())
  brokerAccountId String
  brokerAccount   BrokerAccount @relation(fields: [brokerAccountId], references: [id], onDelete: Cascade)

  status      SyncStatus @default(RUNNING)
  dealsPulled Int        @default(0)
  tradesBuilt Int        @default(0)
  error       String?
  startedAt   DateTime   @default(now())
  finishedAt  DateTime?

  @@index([brokerAccountId])
  @@map("sync_run")
}

enum SyncStatus {
  RUNNING
  DONE
  FAILED
}

// ─── AI coach conversations ───────────────────────────────────────────────────

model AiConversation {
  id              String  @id @default(cuid())
  userId          String
  brokerAccountId String?
  title           String?

  messages AiMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("ai_conversation")
}

model AiMessage {
  id             String         @id @default(cuid())
  conversationId String
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  role    AiRole
  content String @db.Text

  // Web-search citations the assistant used for this message (array of
  // {title,url,snippet}); null for personal answers and all pre-search messages.
  sources Json?
  // Router lane that produced this message ('personal' | 'web' | 'hybrid').
  // Nullable for observability only; null on legacy rows.
  lane    String?

  createdAt DateTime @default(now())

  @@index([conversationId])
  @@map("ai_message")
}

enum AiRole {
  user
  assistant
}

/// Opt-in for the weekly AI review email. One row per user (the email is a single
/// digest covering every account they have), created only when the user turns it
/// on, so an absent row means "not subscribed". Deliberately a separate table:
/// better-auth owns `user`, and this never touches it.
model WeeklyReviewSubscription {
  id      String  @id @default(cuid())
  userId  String  @unique
  /// Opt-in: false until the user explicitly enables it in settings.
  enabled Boolean @default(false)

  /// Cryptographically random, generated in application code (NOT a cuid — this
  /// appears in an unauthenticated unsubscribe link and must be unguessable).
  unsubscribeToken String @unique

  /// When the digest last went out. Also the idempotency guard: a job for a week
  /// that was already sent is a no-op, so a duplicate cron fire can't double-send.
  lastSentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enabled, lastSentAt])
  @@map("weekly_review_subscription")
}

/// Cached AI narrative for one account. Keyed on a hash of the trader-context it
/// was written from: while the hash matches, the stored narrative is reused and no
/// tokens are spent. One row per account (upserted), so the table stays bounded.
model AiReport {
  id              String @id @default(cuid())
  userId          String
  brokerAccountId String

  /// SHA-256 of the TraderContext used to generate `content`.
  dataHash String
  content  String  @db.Text
  /// Model that produced the narrative — for debugging drift after a model swap.
  model    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, brokerAccountId])
  @@index([userId])
  @@map("ai_report")
}

// ─── Phase 2: Economic Calendar + News (shared across all users) ──────────────
// These tables hold data fetched once by the ingestion pipeline and served to
// every user — never fetched per user request. Additive only; nothing here
// touches the better-auth `user` table.

enum EventImpact {
  LOW
  MEDIUM
  HIGH
}

/// One economic-calendar event, reconciled from one or more providers. The
/// `dedupKey` (currency|hour-bucket|normalized-title) makes ingestion idempotent
/// and lets several providers merge into a single row with per-field provenance.
model EconomicEvent {
  id        String      @id @default(cuid())
  dedupKey  String      @unique
  title     String
  country   String // ISO-3166 alpha-2, for the flag
  currency  String // e.g. USD, EUR
  category  String?
  impact    EventImpact @default(LOW)
  eventTime DateTime // always stored UTC

  // Result numbers are strings so units/signs ("%", "K", "-0.2") survive intact.
  actual   String?
  forecast String?
  previous String?
  unit     String?
  actualAt DateTime? // when `actual` was first observed — drives the live flash

  // Per-field provenance + each provider's raw values (same idea as AiMessage.sources).
  sources Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  watches EventWatch[]

  @@index([eventTime])
  @@index([currency, eventTime])
  @@index([impact, eventTime])
  @@map("economic_event")
}

enum NewsCategory {
  CRYPTO
  MACRO
  GEOPOLITICAL
  REGULATORY
  MARKETS
}

enum Sentiment {
  BULLISH
  BEARISH
  NEUTRAL
}

/// One news item, deduped across outlets. LLM-enrichment fields are nullable so
/// the feed serves fully even when AI is off (chips just hide).
model NewsItem {
  id          String        @id @default(cuid())
  dedupKey    String        @unique
  url         String
  title       String
  summary     String?       @db.Text
  source      String
  sources     Json? // "also reported by" cluster
  imageUrl    String?
  publishedAt DateTime
  country     String?
  category    NewsCategory?

  // LLM enrichment (null → un-enriched, still served).
  sentiment    Sentiment?
  relevance    Int? // 0..100
  impact       EventImpact? // HIGH == the red highlight
  marketMoving Boolean      @default(false)
  enrichedAt   DateTime?
  enrichHash   String? // content hash → skip re-enriching unchanged items

  createdAt DateTime @default(now())

  @@index([publishedAt])
  @@index([category, publishedAt])
  @@index([impact, publishedAt])
  @@map("news_item")
}

// ─── Phase 2: per-user preferences, watchlist, delivery ───────────────────────
// Per-user rows keyed by `userId` (no relation edit on the better-auth `user`
// table — same approach as JournalEntry / WeeklyReviewSubscription).

model NotificationPreference {
  id       String @id @default(cuid())
  userId   String @unique
  timezone String @default("UTC") // IANA tz for rendering + reminder math

  inApp Boolean @default(true)
  email Boolean @default(false)
  push  Boolean @default(false)

  minImpact   EventImpact @default(HIGH)
  currencies  String[] // empty = all
  categories  String[] // empty = all
  leadMinutes Int         @default(15)
  newsAlerts  Boolean     @default(false)
  priceAlerts Boolean     @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("notification_preference")
}

/// A user's news-feed personalization. `sources` is the set of preferred outlet
/// keys (e.g. "rss:coindesk"); empty means "no preference" and the feed renders
/// as one unpersonalized list. When set, the feed splits: preferred sources on
/// top, everything else below.
model NewsPreference {
  id      String   @id @default(cuid())
  userId  String   @unique
  sources String[] // preferred outlet keys; empty = no preference

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("news_preference")
}

/// A user pinning a specific event for a reminder.
model EventWatch {
  id      String        @id @default(cuid())
  userId  String
  eventId String
  event   EconomicEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, eventId])
  @@index([userId])
  @@map("event_watch")
}

/// A Web Push endpoint (VAPID). Pruned when the browser reports it gone (404/410).
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("push_subscription")
}

/// The in-app notification-center inbox.
model Notification {
  id      String    @id @default(cuid())
  userId  String
  kind    String // "event_reminder" | "news_alert" | "actual_released"
  title   String
  body    String?   @db.Text
  href    String? // deep link
  eventId String?
  newsId  String?
  readAt  DateTime?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@map("notification")
}

/// Idempotency ledger — one row per (dedupKey, channel) guarantees no double-send.
model NotificationDelivery {
  id       String @id @default(cuid())
  userId   String
  dedupKey String // e.g. "reminder:<eventId>:<leadBucket>"
  channel  String // in_app | email | push

  createdAt DateTime @default(now())

  @@unique([dedupKey, channel])
  @@map("notification_delivery")
}

// ─── Advanced charting: durable candle store + per-user watchlist ─────────────

// Immutable historical bars, persisted for backfill/deep-history. The forming
// (latest) bar is served live over SSE and re-upserted as it closes. Shared
// across all users — keyed by symbol + timeframe + bar open time.
model Candle {
  symbol    String
  timeframe String // 1m | 5m | 15m | 30m | 1h | 4h | 1d | 1w | 1M
  openTime  DateTime
  open      Decimal  @db.Decimal(18, 8)
  high      Decimal  @db.Decimal(18, 8)
  low       Decimal  @db.Decimal(18, 8)
  close     Decimal  @db.Decimal(18, 8)
  volume    Decimal  @db.Decimal(24, 8)
  source    String // binance | mt5 | twelvedata

  @@id([symbol, timeframe, openTime])
  @@index([symbol, timeframe, openTime(sort: Desc)])
  @@map("candle")
}

// One row per user — the symbols they've pinned to their chart watchlist.
model Watchlist {
  userId    String   @id
  symbols   String[]
  updatedAt DateTime @updatedAt

  @@map("watchlist")
}

// A user's price alert: notify when `symbol` crosses `threshold`. Fires on a
// transition (tracked via lastPrice) — one-shot (status→triggered) or recurring
// (re-arms, fireSeq++ for a fresh idempotency slot).
model PriceAlert {
  id          String    @id @default(cuid())
  userId      String
  symbol      String
  accountId   String? // broker symbols route via the account's MT5 creds
  direction   String // "above" | "below"
  threshold   Decimal   @db.Decimal(18, 8)
  lastPrice   Decimal?  @db.Decimal(18, 8) // last observed price (cross detection)
  status      String    @default("active") // active | triggered | disabled
  recurring   Boolean   @default(false)
  fireSeq     Int       @default(0)
  note        String?
  triggeredAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, symbol])
  @@index([userId])
  @@map("price_alert")
}
